# --- PlainDocs engine configuration ---
# All values have working defaults for a local Ollama install. No secrets required locally.

# Ollama endpoint (default shown). For a hosted OpenAI-compatible Gemma endpoint, change this.
VITE_GEMMA_BASE_URL=http://localhost:11434

# Multimodal Gemma used for extraction, translation, simplification, coverage, actions, verification, QA
VITE_GEMMA_MODEL=gemma3:4b

# EmbeddingGemma used for all multilingual retrieval
VITE_EMBED_MODEL=embeddinggemma:300m

# Only needed for hosted endpoints — NEVER commit a real key
# VITE_GEMMA_API_KEY=

# Per-call timeout (ms). CPU inference is slow; default 180000.
VITE_GEMMA_TIMEOUT_MS=180000

# Set to "fixtures" to force the deterministic demo even when Gemma is running
# VITE_ENGINE=fixtures
