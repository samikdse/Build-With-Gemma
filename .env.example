# --- CareLens: hosted Gemma (server-side only) ---
# Set these in the Vercel dashboard, never in committed files.
# The key is read ONLY inside /api serverless functions and is never sent to the browser.

GEMMA_API_KEY=

# Optional. Defaults to Google AI Studio + gemma-3-27b-it.
# GEMMA_API_BASE_URL=
# GEMMA_MODEL=
# GEMMA_VISION_MODEL=

# --- Optional local development with Ollama (NOT used in production) ---
# VITE_GEMMA_BASE_URL=http://localhost:11434
# VITE_GEMMA_MODEL=gemma3:4b
# VITE_EMBED_MODEL=embeddinggemma:300m
